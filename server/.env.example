NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_connect
CLIENT_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=1mb
LOG_FORMAT=dev
JWT_SECRET=replace-with-a-long-random-secret
